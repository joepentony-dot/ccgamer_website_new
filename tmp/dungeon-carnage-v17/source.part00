/*
 * CHEEKY COMMODORE GAMER: DUNGEON CARNAGE 64
 * v1.7 "Carnage Unleashed"
 *
 * Real Commodore 64 cc65 C source.
 * Target: PAL/NTSC C64, joystick port 2.
 *
 * v1.7 priorities:
 * - stronger commercial-style feedback: high score, grades and phase notices
 * - animate player movement and preserve bounded sprite-memory ownership
 * - add timed traps, collapsing floor cells and a rune-operated shortcut
 * - telegraph boss magic before dangerous volleys
 * - improve death feedback without adding unbounded particles/entities
 * - retain hard caps on enemies/projectiles for C64 speed
 */

#include <c64.h>
#include <conio.h>
#include <joystick.h>
#include <stdint.h>
#include <string.h>

#define SCREEN ((unsigned char*)0x8400)
#define COLOR  ((unsigned char*)0xD800)
#define SPRPTR ((unsigned char*)0x87F8)
#define SPRDATA ((unsigned char*)0xB800)
#define SPR_BASE_PTR ((unsigned char)0xE0)

#define SCREEN_W 40
#define SCREEN_H 25
#define MAP_H 22
#define MAP_Y0 3

#define MAX_ENEMIES 6
#define MAX_SHOTS 8
#define MAX_PICKUPS 4

#define TILE_FLOOR 0
#define TILE_WALL 1
#define TILE_BARREL 2
#define TILE_SPIKE 3
#define TILE_WATER 4
#define TILE_LAVA 5
#define TILE_PILLAR 6
#define TILE_EXIT 7
#define TILE_CHEST 8
#define TILE_RUBBLE 9
#define TILE_TORCH 10
#define TILE_SKULL 11
#define TILE_ALTAR 12
#define TILE_SECRET 13
#define TILE_CRACK 14
#define TILE_RUNE 15
#define TILE_GATE 16
#define TILE_FIREJET 17

#define TYPE_NONE 0
#define TYPE_BAT 1
#define TYPE_SLIME 2
#define TYPE_SKELETON 3
#define TYPE_SORCERER 4
#define TYPE_GUARDIAN 5
#define TYPE_BOSS 6

#define AI_IDLE 0
#define AI_TELEGRAPH 1
#define AI_DIVE 2
#define AI_RECOVER 3
#define AI_CHASE 4

#define PICK_NONE 0
#define PICK_MEAT 1
#define PICK_GEM 2
#define PICK_BOMB 3
#define PICK_RAGE 4
#define PICK_SHIELD 5

#define SFX_NONE 0
#define SFX_SWING 1
#define SFX_HIT 2
#define SFX_KILL 3
#define SFX_HURT 4
#define SFX_PICK 5
#define SFX_EXIT 6
#define SFX_BOMB 7
#define SFX_POWER 8
#define SFX_ALTAR 9
#define SFX_SECRET 10
#define SFX_CLEAR 11
#define SFX_WARN 12
#define SFX_RUNE 13
#define SFX_CRUMBLE 14

#define DIR_NONE 255
#define DIR_UP 0
#define DIR_RIGHT 1
#define DIR_DOWN 2
#define DIR_LEFT 3

#define SPR_PLAYER_IDLE 0
#define SPR_PLAYER_ATTACK 1
#define SPR_BAT_A 2
#define SPR_BAT_B 3
#define SPR_BRUTE 4
#define SPR_MAGE 5
#define SPR_BOSS 6
#define SPR_SLASH 7
#define SPR_BRUTE_B 8
#define SPR_SLIME_A 9
#define SPR_SLIME_B 10
#define SPR_MAGE_B 11
#define SPR_BOSS_B 12
#define SPR_GUARDIAN 13
#define SPR_PLAYER_WALK_A 14
#define SPR_PLAYER_WALK_B 15

typedef struct Enemy {
    uint8_t type;
    uint8_t x;
    uint8_t y;
    uint8_t old_x;
    uint8_t old_y;
    int8_t dx;
    int8_t dy;
    uint8_t hp;
    uint8_t maxhp;
    uint8_t state;
    uint8_t timer;
    uint8_t cooldown;
    uint8_t flash;
} Enemy;

typedef struct Shot {
    uint8_t active;
    uint8_t x;
    uint8_t y;
    uint8_t old_x;
    uint8_t old_y;
    int8_t dx;
    int8_t dy;
    uint8_t ttl;
} Shot;

typedef struct Pickup {
    uint8_t type;
    uint8_t x;
    uint8_t y;
    uint8_t active;
} Pickup;

static unsigned char mapbuf[SCREEN_W * MAP_H];
static Enemy enemies[MAX_ENEMIES];
static Shot shots[MAX_SHOTS];
static Pickup pickups[MAX_PICKUPS];

static uint8_t floor_no;
