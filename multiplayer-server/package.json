{
  "name": "ccg-lost-sizzler-multiplayer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus multiplayer server for The Lost Sizzler.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/app.config.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:local": "node tests/horde-room-smoke.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.23",
    "colyseus": "0.18.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "@types/express": "^5.0.3",
    "@types/node": "22.18.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
