<!doctype html>
<html lang="en">
<head>
  {% set pageTitle = title or "Cheeky Commodore Gamer" %}
  {% set pageDescription = description or "Commodore 64 and Amiga games, reviews, features and retro gaming archives from Cheeky Commodore Gamer." %}
  {% set canonicalUrl = canonical or ("https://www.cheekycommodoregamer.co.uk" + page.url) %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="{{ robots or 'index,follow,max-video-preview:-1,max-image-preview:large,max-snippet:-1' }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="Cheeky Commodore Gamer">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  {% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}

  <meta name="twitter:card" content="{{ 'summary_large_image' if ogImage else 'summary' }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:url" content="{{ canonicalUrl }}">
  <meta name="twitter:site" content="@CheekyC64Gamer">
  {% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}

  {% if game and game.schemaJson %}
    <script type="application/ld+json" data-ccg-schema="game-graph">{{ game.schemaJson | safe }}</script>
  {% elif page.url == "/games/" %}
    <script type="application/ld+json" data-ccg-schema="hub-games">{{ hubSchemas.games | safe }}</script>
  {% elif page.url == "/games/publishers/" %}
    <script type="application/ld+json" data-ccg-schema="hub-publishers">{{ hubSchemas.publishers | safe }}</script>
  {% elif page.url == "/games/collections/" %}
    <script type="application/ld+json" data-ccg-schema="hub-collections">{{ hubSchemas.collections | safe }}</script>
  {% elif page.url == "/zzap64/" %}
    <script type="application/ld+json" data-ccg-schema="hub-zzap64">{{ hubSchemas.zzap64 | safe }}</script>
  {% elif structuredDataJson %}
    <script type="application/ld+json" data-ccg-schema="page-graph">{{ structuredDataJson | safe }}</script>
  {% endif %}

  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="/">Cheeky Commodore Gamer</a>
      {% include "components/site-nav.njk" %}
    </div>
  </header>

  <main class="wrap" id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="wrap site-footer">
    <p>Commodore 64 &amp; Amiga archive prototype.</p>
  </footer>
</body>
</html>
