<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Cheeky Commodore Gamer" }}</title>
  <meta name="description" content="{{ description or 'A fast, static prototype for the Cheeky Commodore Gamer archive.' }}">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="/">Cheeky Commodore Gamer</a>
      {% include "components/site-nav.njk" %}
    </div>
  </header>

  <main class="wrap" id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="wrap site-footer">
    <p>Commodore 64 &amp; Amiga archive prototype.</p>
  </footer>
</body>
</html>
