{
  "instructions": "Edit js/asset-overrides.js for versioned local assets, or use the Arcade Asset Manager to add multiple live tracks to any Lost Sizzler category.",
  "images": {
    "logo": "assets/ccgamer-logo-fallback.svg",
    "namedEnemies": {
      "Peter Cortens": "assets/peter-cortens.png",
      "Swanh8ter": "assets/swanh8ter.png",
      "Syragar": "assets/syragar.png",
      "Parsnip Celery": "assets/parsnip-celery.png",
      "CPU": "assets/cpu.png",
      "Yoshi Yoshi": "assets/yoshi-yoshi.png",
      "CCG": "canvas-generated creature unless overridden"
    },
    "items": "Items use canvas artwork by default. Any images.items key in js/asset-overrides.js can replace its matching floor collectible."
  },
  "music": {
    "categories": ["normal", "danger", "sanctuary", "named", "stalker"],
    "fallbacks": {
      "normal": "assets/audio/music/exploration.wav",
      "danger": "assets/audio/music/danger.wav",
      "sanctuary": "assets/audio/music/sanctuary.wav",
      "named": "assets/audio/music/named-enemy.wav",
      "stalker": "assets/audio/music/count-loadula.wav"
    },
    "playback": {
      "selection": "random within the active category",
      "repeatProtection": "the previous track is excluded when alternatives exist",
      "crossfadeMs": 2500,
      "priority": ["stalker", "named", "danger", "sanctuary", "normal"],
      "normalBehaviour": "General Exploration resumes when no encounter category is active"
    },
    "adminUploadKeys": {
      "normal": "lostSizzlerExploration--<unique-track-id>",
      "danger": "lostSizzlerDanger--<unique-track-id>",
      "sanctuary": "lostSizzlerSanctuary--<unique-track-id>",
      "named": "lostSizzlerNamed--<unique-track-id>",
      "stalker": "lostSizzlerStalker--<unique-track-id>"
    }
  },
  "sfx": {
    "folder": "assets/audio/sfx/",
    "overrideKeys": ["fire", "hit", "death", "playerDeath", "elite", "hurt", "pickup", "key", "exitSigil", "bronze", "dash", "enemy", "alert", "search", "food", "flame", "wall", "open", "heal", "empty", "respawn", "win", "join", "warp", "door", "dooropen", "locked", "weapon", "armour", "potion", "torch", "room", "campwarn", "explosion", "lowhealth", "cloak", "level", "shrine", "stalker", "trap", "generator", "secret"]
  }
}
