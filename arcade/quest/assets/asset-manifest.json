{
  "project": "Cheeky's Commodore Quest",
  "overhaul": "Quest 2.0",
  "branch": "codex/commodore-quest-overhaul",
  "policy": {
    "mainBranchSafety": "Do not alter the current working Quest on main while the overhaul is in progress.",
    "productionRule": "Only runtime-ready artwork belongs in assets/production.",
    "sourceRule": "Component art, working files and reconstruction pieces belong in assets/source when migrated.",
    "archiveRule": "Recovered, superseded and preservation-only artwork belongs in assets/archive when migrated.",
    "replacementRule": "New sprite artwork must be wired through explicit metadata and state-specific anchors/hitboxes rather than assuming one fixed draw box for every animation."
  },
  "priority": [
    "player",
    "core-gameplay",
    "stage-identity",
    "enemies-and-hazards",
    "bosses",
    "ui-and-feedback",
    "audio-polish"
  ],
  "categories": {
    "player": {
      "status": "replace-first",
      "runtime": [
        "assets/production/player/cheeky-main-sheet.png",
        "assets/production/player/cheeky-fight-sheet.png"
      ],
      "componentArt": [
        "assets/production/player/cheeky-mascot.png",
        "assets/production/player/cheeky-head.png",
        "assets/production/player/cheeky-body.png",
        "assets/production/player/cheeky-arm.png",
        "assets/production/player/cheeky-leg.png"
      ],
      "notes": [
        "Current main sprite sheet does not sell the duck/crouch strongly enough.",
        "Current runtime draws all main-sheet states through one fixed display box.",
        "Quest 2.0 should support per-state draw size, ground anchor, visual offset and collision box.",
        "Minimum replacement states: idle, run, jump takeoff, rise, apex, fall, land, deep crouch, crouch-fire, stand-fire, hit and victory.",
        "Fighting mode should have a true crouch/duck state rather than visually substituting guard."
      ]
    },
    "bosses": {
      "status": "review",
      "runtime": [
        "assets/production/bosses/bedroom-sheet.png",
        "assets/production/bosses/budget-sheet.png",
        "assets/production/bosses/christmas-sheet.png",
        "assets/production/bosses/amiga-sheet.png",
        "assets/production/bosses/guru-sheet.png"
      ],
      "singleFrameFallbacks": [
        "assets/production/bosses/bedroom.png",
        "assets/production/bosses/budget.png",
        "assets/production/bosses/christmas.png",
        "assets/production/bosses/amiga.png",
        "assets/production/bosses/guru.png"
      ],
      "notes": [
        "Retain for comparison until each redesigned boss is approved.",
        "Boss redesign should include stage-specific mechanics rather than palette/theme changes around the same fight structure."
      ]
    },
    "enemies": {
      "status": "review-and-expand",
      "runtime": [
        "assets/production/enemies/8bit-enemy-sheet.png"
      ],
      "notes": [
        "One generic 8-bit enemy sheet is insufficient for five themed runner stages.",
        "Quest 2.0 should give each major stage at least one distinct enemy family or behaviour set."
      ]
    },
    "fighter": {
      "status": "review",
      "runtime": [
        "assets/production/fighter/retsu-sheet.png",
        "assets/production/fighter/tiertex-idle.png",
        "assets/production/fighter/tiertex-punch.png",
        "assets/production/fighter/tiertex-kick.png",
        "assets/production/fighter/tiertex-hit.png"
      ],
      "notes": [
        "Keep the sheet as the preferred runtime path while the fighting section is redesigned.",
        "Remove duplicate/superseded source copies from production during the later physical sort."
      ]
    },
    "hazards": {
      "status": "review-and-expand",
      "runtime": [
        "assets/production/hazards/bedroom.png",
        "assets/production/hazards/budget.png",
