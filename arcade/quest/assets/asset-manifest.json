        "assets/backgrounds/fighter.svg",
        "assets/backgrounds/invaders.svg",
        "assets/backgrounds/christmas.svg",
        "assets/backgrounds/maze.svg",
        "assets/backgrounds/amiga.svg",
        "assets/backgrounds/guru.svg"
      ],
      "notes": [
        "Do not remove the existing remote background override mechanism during the overhaul.",
        "Add Back/Mid/Front parallax layers only where they improve stage depth."
      ]
