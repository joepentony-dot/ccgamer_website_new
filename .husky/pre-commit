#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -e

echo "Running CCG UI Contract Checks..."

# Fail if game button contract reintroduces rounded corners
if rg -nP "(\.game-page button|\.game-cta)\s*\{[^}]*border-radius:\s*(?!0(?:px)?\b)" resources/css/games.css >/dev/null 2>&1; then
  echo "❌ Rounded corners detected on game button contract selectors."
  exit 1
fi

# Fail if deprecated auth login route is referenced
if rg -n '/auth/login\.html|https://www\.cheekycommodoregamer\.co\.uk/auth/login\.html' --glob '*.html' js resources >/dev/null 2>&1; then
  echo "❌ Deprecated auth route detected. Use canonical /community/index.html entry."
  exit 1
fi

# Fail if more than one header Join/Login button exists in any page
if rg -n 'id="join-login"' -g '*.html' . | awk -F: '{count[$1]++} END {for (f in count) if (count[f] > 1) {print f; bad=1} exit bad}'; then
  :
else
  echo "❌ Multiple header Join/Login buttons detected in a single HTML file."
  exit 1
fi

# Fail if non-canonical files add local nav margin drift overrides
if rg -n "ccg-(header-inner|nav|header-actions)[^{]*\{[^}]*margin-(left|right|inline)" resources/css --glob '!ccg-nav.css' >/dev/null 2>&1; then
  echo "❌ Potential nav alignment drift override detected outside ccg-nav.css."
  exit 1
fi

echo "UI Contract checks passed!"
