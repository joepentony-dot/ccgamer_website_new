{
  "id": "/",
  "name": "Cheeky Commodore Gamer",
  "short_name": "CCG",
  "description": "Explore Commodore 64 and Amiga games, videos, music, collections and quizzes.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/app-launch.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#020711",
  "theme_color": "#020711",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/resources/images/ccg-app-icon-v2.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/resources/images/ccg-app-icon-v2.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/resources/images/ccg-app-icon-maskable-v2.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Games",
      "short_name": "Games",
      "description": "Open the C64 and Amiga game archive.",
      "url": "/games/?source=pwa-shortcut",
      "icons": [
        {
          "src": "/resources/images/ccg-app-icon-v2.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Find Me a Game",
      "short_name": "Game Finder",
      "description": "Choose a Commodore game from the archive.",
      "url": "/games/discover/?source=pwa-shortcut",
      "icons": [
        {
          "src": "/resources/images/ccg-app-icon-v2.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Commodore Quiz",
      "short_name": "Quiz",
      "description": "Test your C64 and Amiga knowledge.",
      "url": "/quiz/quiz.html?source=pwa-shortcut",
      "icons": [
        {
          "src": "/resources/images/ccg-app-icon-v2.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
